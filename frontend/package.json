{
  "name": "utteran-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Utteran next GUI (UI-2 foundation). Built into src/utteran_gui/web-next; served only with --next-ui.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "vue": "3.5.44",
    "vuetify": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "npm@11.21.1"
}

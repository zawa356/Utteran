[
  {
    "id": "G0-01",
    "group": "G0",
    "description": "Verify process-tree peak memory sampling with a 100 MiB child allocation",
    "command": [
      "{python}",
      "-c",
      "import subprocess,sys; p=subprocess.Popen([sys.executable,'-c','import time; x=bytearray(100*1024*1024); time.sleep(3)']); raise SystemExit(p.wait())"
    ],
    "expected_exit_codes": [0],
    "timeout_seconds": 30,
    "minimum_peak_memory_bytes": 94371840
  },

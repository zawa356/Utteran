# Keep repository text stable across Windows and Unix checkouts.
* text=auto eol=lf

# Windows entry points use CRLF while retaining their UTF-8 BOM bytes.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never pass binary media, archives, models, or executables through text filters.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.m4a binary
*.flac binary
*.ogg binary
*.mp4 binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.pyd binary
*.bin binary
*.onnx binary
*.pt binary
*.pth binary
*.safetensors binary

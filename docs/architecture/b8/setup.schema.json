{
  "$defs": {
    "ASRSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "faster-whisper",
            "whisper-cpp",
            "openvino-genai"
          ],
          "title": "Backend",
          "type": "string"
        },
        "beam_size": {
          "maximum": 100,
          "minimum": 1,
          "title": "Beam Size",
          "type": "integer"
        },
        "condition_on_previous_text": {
          "title": "Condition On Previous Text",
          "type": "boolean"
        },
        "extra_arguments": {
          "$ref": "#/$defs/ExtraArguments"
        },
        "faster_whisper": {
          "$ref": "#/$defs/FasterWhisperSettings"
        },
        "glossary": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Glossary",
          "type": "array"
        },
        "initial_prompt": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Prompt"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "openvino_genai": {
          "$ref": "#/$defs/GenAISettings"
        },
        "vad": {
          "$ref": "#/$defs/VadSettings"
        },
        "whisper_cpp": {
          "$ref": "#/$defs/WhisperCppSettings"
        },
        "word_timestamps": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "title": "Word Timestamps",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model",
        "language",
        "initial_prompt",
        "glossary",
        "beam_size",
        "vad",
        "word_timestamps",
        "condition_on_previous_text"
      ],
      "title": "ASRSettings",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "accepted_agreement_ids": {
          "items": {
            "pattern": "^hf-gated:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
            "type": "string"
          },
          "title": "Accepted Agreement Ids",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "pattern": "^apr_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^plan_[0-9a-f]{32}$",
          "title": "Plan Id",
          "type": "string"
        },
        "plan_revision": {
          "minimum": 1,
          "title": "Plan Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "plan_id",
        "plan_revision",
        "plan_hash",
        "accepted_agreement_ids",
        "expires_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "properties": {
        "accepted_agreement_ids": {
          "items": {
            "pattern": "^hf-gated:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Accepted Agreement Ids",
          "type": "array"
        },
        "plan_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "plan_hash",
        "accepted_agreement_ids"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "DiarizationSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "pyannote",
          "title": "Backend",
          "type": "string"
        },
        "device_preference": {
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "xpu"
          ],
          "title": "Device Preference",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "max_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Speakers"
        },
        "memory_guard": {
          "enum": [
            "auto",
            "warn",
            "off"
          ],
          "title": "Memory Guard",
          "type": "string"
        },
        "memory_safety_margin": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Memory Safety Margin",
          "type": "number"
        },
        "min_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Speakers"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "num_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Num Speakers"
        }
      },
      "required": [
        "enabled",
        "backend",
        "model",
        "device_preference",
        "num_speakers",
        "min_speakers",
        "max_speakers",
        "memory_guard"
      ],
      "title": "DiarizationSettings",
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "``null`` means unknown. Values come only from catalog sizes; nothing is guessed.",
      "properties": {
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "disk_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disk Bytes"
        },
        "download_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Download Bytes"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Seconds"
        }
      },
      "required": [
        "download_bytes",
        "disk_bytes",
        "duration_seconds",
        "confidence"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "ExtraArguments": {
      "additionalProperties": false,
      "properties": {
        "allow_unverified": {
          "title": "Allow Unverified",
          "type": "boolean"
        },
        "backend": {
          "const": "whisper-cpp",
          "title": "Backend",
          "type": "string"
        },
        "tokens": {
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "backend",
        "tokens",
        "allow_unverified"
      ],
      "title": "ExtraArguments",
      "type": "object"
    },
    "FasterWhisperSettings": {
      "additionalProperties": false,
      "properties": {
        "compute_type": {
          "enum": [
            "auto",
            "int8",
            "int8_float32",
            "int8_float16",
            "float16",
            "float32"
          ],
          "title": "Compute Type",
          "type": "string"
        }
      },
      "title": "FasterWhisperSettings",
      "type": "object"
    },
    "GenAISettings": {
      "additionalProperties": false,
      "properties": {
        "max_new_tokens": {
          "minimum": 1,
          "title": "Max New Tokens",
          "type": "integer"
        }
      },
      "title": "GenAISettings",
      "type": "object"
    },
    "OperationStatus": {
      "enum": [
        "queued",
        "held",
        "blocked",
        "running",
        "waiting_user",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "OperationStatus",
      "type": "string"
    },
    "OutputSettings": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "srt",
              "vtt",
              "json",
              "txt",
              "md"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array",
          "uniqueItems": true
        },
        "newline": {
          "enum": [
            "lf",
            "crlf"
          ],
          "title": "Newline",
          "type": "string"
        },
        "show_speaker": {
          "title": "Show Speaker",
          "type": "boolean"
        },
        "speaker_labels": {
          "additionalProperties": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Speaker Labels",
          "type": "object"
        },
        "srt_bom": {
          "title": "Srt Bom",
          "type": "boolean"
        }
      },
      "required": [
        "formats",
        "newline",
        "srt_bom",
        "show_speaker",
        "speaker_labels"
      ],
      "title": "OutputSettings",
      "type": "object"
    },
    "PlanContent": {
      "additionalProperties": false,
      "description": "Hashed plan body (``plan_hash`` = SHA-256 of its canonical JSON).",
      "properties": {
        "apply_defaults": {
          "title": "Apply Defaults",
          "type": "boolean"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/SetupChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "diarization_enabled": {
          "title": "Diarization Enabled",
          "type": "boolean"
        },
        "estimate": {
          "$ref": "#/$defs/Estimate"
        },
        "inventory_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inventory Fingerprint",
          "type": "string"
        },
        "missing_credentials": {
          "items": {
            "const": "hf_token",
            "type": "string"
          },
          "title": "Missing Credentials",
          "type": "array"
        },
        "model_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
            "type": "string"
          },
          "title": "Model Refs",
          "type": "array"
        },
        "preserved_environment_ids": {
          "items": {
            "enum": [
              "cpu",
              "cuda",
              "intel",
              "vulkan"
            ],
            "type": "string"
          },
          "title": "Preserved Environment Ids",
          "type": "array"
        },
        "profile_kind": {
          "enum": [
            "cpu",
            "cuda",
            "intel",
            "vulkan"
          ],
          "title": "Profile Kind",
          "type": "string"
        },
        "required_agreements": {
          "items": {
            "pattern": "^hf-gated:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
            "type": "string"
          },
          "title": "Required Agreements",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SetupStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/PlanVerification"
        }
      },
      "required": [
        "schema_version",
        "profile_kind",
        "model_refs",
        "diarization_enabled",
        "inventory_fingerprint",
        "estimate",
        "changes",
        "steps",
        "preserved_environment_ids",
        "required_agreements",
        "missing_credentials"
      ],
      "title": "PlanContent",
      "type": "object"
    },
    "PlanVerification": {
      "additionalProperties": false,
      "description": "Stored (private) verification target of a plan; never returned as is.",
      "properties": {
        "model_ref": {
          "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
          "title": "Model Ref",
          "type": "string"
        },
        "recipe_id": {
          "enum": [
            "fw-cpu",
            "fw-cuda",
            "wc-vulkan",
            "wc-ov",
            "wc-ov-vk"
          ],
          "title": "Recipe Id",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/ProcessingSettings"
        }
      },
      "required": [
        "recipe_id",
        "model_ref",
        "settings"
      ],
      "title": "PlanVerification",
      "type": "object"
    },
    "PlanVerificationView": {
      "additionalProperties": false,
      "properties": {
        "model_ref": {
          "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./-]{0,199}$",
          "title": "Model Ref",
          "type": "string"
        },
        "recipe_id": {
          "enum": [
            "fw-cpu",
            "fw-cuda",
            "wc-vulkan",
            "wc-ov",
            "wc-ov-vk"
          ],
          "title": "Recipe Id",
          "type": "string"
        },
        "settings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Settings Sha256",
          "type": "string"
        }
      },
      "required": [
        "recipe_id",
        "model_ref",
        "settings_sha256"
      ],
      "title": "PlanVerificationView",
      "type": "object"
    },
    "PostprocessingSettings": {
      "additionalProperties": false,
      "properties": {
        "boundary_snap_enabled": {
          "title": "Boundary Snap Enabled",
          "type": "boolean"
        },
        "boundary_snap_max_characters": {
          "minimum": 0,
          "title": "Boundary Snap Max Characters",
          "type": "integer"
        },
        "boundary_snap_max_gap": {
          "minimum": 0,
          "title": "Boundary Snap Max Gap",
          "type": "number"
        },
        "boundary_snap_unit": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Boundary Snap Unit",
          "type": "string"
        },
        "fallback_characters_per_second": {
          "minimum": 0,
          "title": "Fallback Characters Per Second",
          "type": "number"
        },
        "fallback_duration_padding": {
          "minimum": 0,
          "title": "Fallback Duration Padding",
          "type": "number"
        },
        "fallback_min_duration": {
          "minimum": 0,
          "title": "Fallback Min Duration",
          "type": "number"
        },
        "max_nearest_distance": {
          "minimum": 0,
          "title": "Max Nearest Distance",
          "type": "number"
        },
        "max_same_speaker_bridge_gap": {
          "minimum": 0,
          "title": "Max Same Speaker Bridge Gap",
          "type": "number"
        },
        "max_unsupported_fragment_characters": {
          "minimum": 0,
          "title": "Max Unsupported Fragment Characters",
          "type": "integer"
        },
        "max_unsupported_fragment_duration": {
          "minimum": 0,
          "title": "Max Unsupported Fragment Duration",
          "type": "number"
        },
        "merge_gap": {
          "minimum": 0,
          "title": "Merge Gap",
          "type": "number"
        },
        "min_clear_turn_duration": {
          "minimum": 0,
          "title": "Min Clear Turn Duration",
          "type": "number"
        },
        "min_fragment_speaker_overlap": {
          "minimum": 0,
          "title": "Min Fragment Speaker Overlap",
          "type": "number"
        },
        "min_segment_duration": {
          "minimum": 0,
          "title": "Min Segment Duration",
          "type": "number"
        },
        "min_segment_words": {
          "minimum": 0,
          "title": "Min Segment Words",
          "type": "integer"
        },
        "min_unknown_characters": {
          "minimum": 0,
          "title": "Min Unknown Characters",
          "type": "integer"
        },
        "min_unknown_duration": {
          "minimum": 0,
          "title": "Min Unknown Duration",
          "type": "number"
        },
        "renumber_speakers": {
          "title": "Renumber Speakers",
          "type": "boolean"
        },
        "silence_switch_threshold": {
          "minimum": 0,
          "title": "Silence Switch Threshold",
          "type": "number"
        },
        "speaker_switch_penalty": {
          "minimum": 0,
          "title": "Speaker Switch Penalty",
          "type": "number"
        },
        "unknown_emission_score": {
          "minimum": 0,
          "title": "Unknown Emission Score",
          "type": "number"
        }
      },
      "required": [
        "boundary_snap_enabled",
        "boundary_snap_unit",
        "merge_gap",
        "speaker_switch_penalty"
      ],
      "title": "PostprocessingSettings",
      "type": "object"
    },
    "ProcessingSettings": {
      "additionalProperties": false,
      "properties": {
        "asr": {
          "$ref": "#/$defs/ASRSettings"
        },
        "diarization": {
          "$ref": "#/$defs/DiarizationSettings"
        },
        "output": {
          "$ref": "#/$defs/OutputSettings"
        },
        "postprocessing": {
          "$ref": "#/$defs/PostprocessingSettings"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "asr",
        "diarization",
        "postprocessing",
        "output"
      ],
      "title": "ProcessingSettings",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Fixed reason vocabulary. Free-form caller text is never stored or echoed.",
      "enum": [
        "submitted",
        "user_hold",
        "user_release",
        "user_reorder",
        "user_cancel",
        "cancel_accepted",
        "prestart_revalidation_failed",
        "resources_available",
        "dispatch_started",
        "launch_confirmed",
        "launch_failed",
        "completion_verified",
        "classified_failure",
        "termination_failed",
        "exit_reconciled",
        "credential_required",
        "agreement_required",
        "explicit_resume",
        "owner_lost",
        "recovery_held",
        "recovery_paused",
        "recovery_owner_unverified",
        "recovery_pid_reused",
        "recovery_launch_unconfirmed",
        "recovery_child_alive",
        "queue_paused",
        "queue_resumed",
        "step_progress",
        "reapproval_required"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SetupAttempt": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "id": {
          "pattern": "^att_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "launch": {
          "enum": [
            "intended",
            "confirmed",
            "failed"
          ],
          "title": "Launch",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "released",
            "interrupted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "number",
        "state",
        "launch",
        "started_at",
        "ended_at"
      ],
      "title": "SetupAttempt",
      "type": "object"
    },
    "SetupCancelRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "cooperative",
            "force"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "mode"
      ],
      "title": "SetupCancelRequest",
      "type": "object"
    },
    "SetupChange": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "create",
            "reuse",
            "rebuild",
            "verify"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "profile_missing",
            "profile_compatible",
            "model_not_observed",
            "model_present_unverified"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "profile",
            "model",
            "native",
            "ir"
          ],
          "title": "Resource Kind",
          "type": "string"
        }
      },
      "required": [
        "resource_kind",
        "resource_id",
        "action",
        "reason_code"
      ],
      "title": "SetupChange",
      "type": "object"
    },
    "SetupErrorView": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "launch_failed",
            "process_failed",
            "verification_failed",
            "network_error",
            "preflight_invalid",
            "executor_failed",
            "unsupported_step",
            "smoke_failed"
          ],
          "title": "Code",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {

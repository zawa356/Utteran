{
  "$defs": {
    "ASRSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "faster-whisper",
            "whisper-cpp",
            "openvino-genai"
          ],
          "title": "Backend",
          "type": "string"
        },
        "beam_size": {
          "maximum": 100,
          "minimum": 1,
          "title": "Beam Size",
          "type": "integer"
        },
        "condition_on_previous_text": {
          "title": "Condition On Previous Text",
          "type": "boolean"
        },
        "extra_arguments": {
          "$ref": "#/$defs/ExtraArguments"
        },
        "faster_whisper": {
          "$ref": "#/$defs/FasterWhisperSettings"
        },
        "glossary": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Glossary",
          "type": "array"
        },
        "initial_prompt": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Prompt"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "openvino_genai": {
          "$ref": "#/$defs/GenAISettings"
        },
        "vad": {
          "$ref": "#/$defs/VadSettings"
        },
        "whisper_cpp": {
          "$ref": "#/$defs/WhisperCppSettings"
        },
        "word_timestamps": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "title": "Word Timestamps",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model",
        "language",
        "initial_prompt",
        "glossary",
        "beam_size",
        "vad",
        "word_timestamps",
        "condition_on_previous_text"
      ],
      "title": "ASRSettings",
      "type": "object"
    },
    "DiarizationSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "pyannote",
          "title": "Backend",
          "type": "string"
        },
        "device_preference": {
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "xpu"
          ],
          "title": "Device Preference",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "max_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Speakers"
        },
        "memory_guard": {
          "enum": [
            "auto",
            "warn",
            "off"
          ],
          "title": "Memory Guard",
          "type": "string"
        },
        "memory_safety_margin": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Memory Safety Margin",
          "type": "number"
        },
        "min_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Speakers"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "num_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Num Speakers"
        }
      },
      "required": [
        "enabled",
        "backend",
        "model",
        "device_preference",
        "num_speakers",
        "min_speakers",
        "max_speakers",
        "memory_guard"
      ],
      "title": "DiarizationSettings",
      "type": "object"
    },
    "ExtraArguments": {
      "additionalProperties": false,
      "properties": {
        "allow_unverified": {
          "title": "Allow Unverified",
          "type": "boolean"
        },
        "backend": {
          "const": "whisper-cpp",
          "title": "Backend",
          "type": "string"
        },
        "tokens": {
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "backend",
        "tokens",
        "allow_unverified"
      ],
      "title": "ExtraArguments",
      "type": "object"
    },
    "FasterWhisperSettings": {
      "additionalProperties": false,
      "properties": {
        "compute_type": {
          "enum": [

{
  "$defs": {
    "ASRSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "faster-whisper",
            "whisper-cpp",
            "openvino-genai"
          ],
          "title": "Backend",
          "type": "string"
        },
        "beam_size": {
          "maximum": 100,
          "minimum": 1,
          "title": "Beam Size",
          "type": "integer"
        },
        "condition_on_previous_text": {
          "title": "Condition On Previous Text",
          "type": "boolean"
        },
        "extra_arguments": {
          "$ref": "#/$defs/ExtraArguments"
        },
        "faster_whisper": {
          "$ref": "#/$defs/FasterWhisperSettings"
        },
        "glossary": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Glossary",
          "type": "array"
        },
        "initial_prompt": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Prompt"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "openvino_genai": {
          "$ref": "#/$defs/GenAISettings"
        },
        "vad": {
          "$ref": "#/$defs/VadSettings"
        },
        "whisper_cpp": {
          "$ref": "#/$defs/WhisperCppSettings"
        },
        "word_timestamps": {
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "title": "Word Timestamps",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model",
        "language",
        "initial_prompt",
        "glossary",
        "beam_size",
        "vad",
        "word_timestamps",
        "condition_on_previous_text"
      ],
      "title": "ASRSettings",
      "type": "object"
    },
    "DiarizationSettings": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "pyannote",
          "title": "Backend",
          "type": "string"
        },
        "device_preference": {
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "xpu"
          ],
          "title": "Device Preference",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "max_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Speakers"
        },
        "memory_guard": {
          "enum": [
            "auto",
            "warn",
            "off"
          ],
          "title": "Memory Guard",
          "type": "string"
        },
        "memory_safety_margin": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Memory Safety Margin",
          "type": "number"
        },
        "min_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Speakers"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "num_speakers": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Num Speakers"
        }
      },
      "required": [
        "enabled",
        "backend",
        "model",
        "device_preference",
        "num_speakers",
        "min_speakers",
        "max_speakers",
        "memory_guard"
      ],
      "title": "DiarizationSettings",
      "type": "object"
    },
    "ExtraArguments": {
      "additionalProperties": false,
      "properties": {
        "allow_unverified": {
          "title": "Allow Unverified",
          "type": "boolean"
        },
        "backend": {
          "const": "whisper-cpp",
          "title": "Backend",
          "type": "string"
        },
        "tokens": {
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "backend",
        "tokens",
        "allow_unverified"
      ],
      "title": "ExtraArguments",
      "type": "object"
    },
    "FasterWhisperSettings": {
      "additionalProperties": false,
      "properties": {
        "compute_type": {
          "enum": [
            "auto",
            "int8",
            "int8_float32",
            "int8_float16",
            "float16",
            "float32"
          ],
          "title": "Compute Type",
          "type": "string"
        }
      },
      "title": "FasterWhisperSettings",
      "type": "object"
    },
    "GenAISettings": {
      "additionalProperties": false,
      "properties": {
        "max_new_tokens": {
          "minimum": 1,
          "title": "Max New Tokens",
          "type": "integer"
        }
      },
      "title": "GenAISettings",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Message Key",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code",
        "message_key"
      ],
      "title": "Issue",
      "type": "object"
    },
    "OutputSettings": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "srt",
              "vtt",
              "json",
              "txt",
              "md"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array",
          "uniqueItems": true
        },
        "newline": {
          "enum": [
            "lf",
            "crlf"
          ],
          "title": "Newline",
          "type": "string"
        },
        "show_speaker": {
          "title": "Show Speaker",
          "type": "boolean"
        },
        "speaker_labels": {
          "additionalProperties": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Speaker Labels",
          "type": "object"
        },
        "srt_bom": {
          "title": "Srt Bom",
          "type": "boolean"
        }
      },
      "required": [
        "formats",
        "newline",
        "srt_bom",
        "show_speaker",
        "speaker_labels"
      ],
      "title": "OutputSettings",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "fallback": {
                "const": "none"
              },
              "fixed_candidate_id": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "auto"
              }
            }
          },
          "then": {
            "properties": {
              "fixed_candidate_id": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "allowed_profile_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Profile Ids",
          "type": "array"
        },
        "execution_deadline_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Deadline Seconds"
        },
        "fallback": {
          "enum": [
            "none",
            "preapproved"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "fixed_candidate_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fixed Candidate Id"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "max_memory_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Memory Bytes"
        },
        "mode": {
          "enum": [
            "auto",
            "fixed"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "enum": [
            "quality",
            "speed",
            "balanced"
          ],
          "title": "Objective",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name",
        "mode",
        "fixed_candidate_id",
        "allowed_profile_ids",
        "objective",
        "max_memory_bytes",
        "fallback",
        "execution_deadline_seconds",
        "id",
        "revision"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PolicyList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Policy"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "items",
        "next_cursor"
      ],
      "title": "PolicyList",
      "type": "object"
    },
    "PostprocessingSettings": {
      "additionalProperties": false,
      "properties": {
        "boundary_snap_enabled": {
          "title": "Boundary Snap Enabled",
          "type": "boolean"
        },
        "boundary_snap_max_characters": {
          "minimum": 0,
          "title": "Boundary Snap Max Characters",
          "type": "integer"
        },
        "boundary_snap_max_gap": {
          "minimum": 0,
          "title": "Boundary Snap Max Gap",
          "type": "number"
        },
        "boundary_snap_unit": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Boundary Snap Unit",
          "type": "string"
        },
        "fallback_characters_per_second": {
          "minimum": 0,
          "title": "Fallback Characters Per Second",
          "type": "number"
        },
        "fallback_duration_padding": {
          "minimum": 0,
          "title": "Fallback Duration Padding",
          "type": "number"
        },
        "fallback_min_duration": {
          "minimum": 0,
          "title": "Fallback Min Duration",
          "type": "number"
        },
        "max_nearest_distance": {
          "minimum": 0,
          "title": "Max Nearest Distance",
          "type": "number"
        },
        "max_same_speaker_bridge_gap": {
          "minimum": 0,
          "title": "Max Same Speaker Bridge Gap",
          "type": "number"
        },
        "max_unsupported_fragment_characters": {
          "minimum": 0,
          "title": "Max Unsupported Fragment Characters",
          "type": "integer"
        },
        "max_unsupported_fragment_duration": {
          "minimum": 0,
          "title": "Max Unsupported Fragment Duration",
          "type": "number"
        },
        "merge_gap": {
          "minimum": 0,
          "title": "Merge Gap",
          "type": "number"
        },
        "min_clear_turn_duration": {
          "minimum": 0,
          "title": "Min Clear Turn Duration",
          "type": "number"
        },
        "min_fragment_speaker_overlap": {
          "minimum": 0,
          "title": "Min Fragment Speaker Overlap",
          "type": "number"
        },
        "min_segment_duration": {
          "minimum": 0,
          "title": "Min Segment Duration",
          "type": "number"
        },
        "min_segment_words": {
          "minimum": 0,
          "title": "Min Segment Words",
          "type": "integer"
        },
        "min_unknown_characters": {
          "minimum": 0,
          "title": "Min Unknown Characters",
          "type": "integer"
        },
        "min_unknown_duration": {
          "minimum": 0,
          "title": "Min Unknown Duration",
          "type": "number"
        },
        "renumber_speakers": {
          "title": "Renumber Speakers",
          "type": "boolean"
        },
        "silence_switch_threshold": {
          "minimum": 0,
          "title": "Silence Switch Threshold",
          "type": "number"
        },
        "speaker_switch_penalty": {
          "minimum": 0,
          "title": "Speaker Switch Penalty",
          "type": "number"
        },
        "unknown_emission_score": {
          "minimum": 0,
          "title": "Unknown Emission Score",
          "type": "number"
        }
      },
      "required": [
        "boundary_snap_enabled",
        "boundary_snap_unit",
        "merge_gap",
        "speaker_switch_penalty"
      ],
      "title": "PostprocessingSettings",
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/ProcessingSettings"
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "name",
        "settings"
      ],
      "title": "Preset",
      "type": "object"
    },
    "PresetList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Preset"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "items",
        "next_cursor"
      ],
      "title": "PresetList",
      "type": "object"
    },
    "ProcessingSettings": {
      "additionalProperties": false,
      "properties": {
        "asr": {
          "$ref": "#/$defs/ASRSettings"
        },
        "diarization": {
          "$ref": "#/$defs/DiarizationSettings"
        },
        "output": {
          "$ref": "#/$defs/OutputSettings"
        },
        "postprocessing": {
          "$ref": "#/$defs/PostprocessingSettings"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "asr",
        "diarization",
        "postprocessing",
        "output"
      ],
      "title": "ProcessingSettings",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "input_source": {
          "enum": [
            "preset",
            "common",
            "file"
          ],
          "title": "Input Source",
          "type": "string"
        },
        "input_status": {
          "enum": [
            "value",
            "null",
            "empty",
            "absent"
          ],
          "title": "Input Status",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source": {
          "enum": [
            "preset",
            "common",
            "file",
            "normalization"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source",
        "input_source",
        "input_status"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "VadSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "VadSettings",
      "type": "object"
    },
    "ValidatedFile": {
      "additionalProperties": false,
      "properties": {
        "client_file_id": {
          "title": "Client File Id",
          "type": "string"
        },
        "effective_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessingSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "worker_support": {
          "enum": [
            "unsupported",
            "unverified"
          ],
          "title": "Worker Support",
          "type": "string"
        }
      },
      "required": [
        "client_file_id",
        "valid",
        "effective_settings",
        "provenance",
        "issues",
        "warnings",
        "worker_support"
      ],
      "title": "ValidatedFile",
      "type": "object"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/ValidatedFile"
          },
          "title": "Files",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "preset_ref": {
          "$ref": "#/$defs/Ref"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "valid",
        "preset_ref",
        "policy_ref",
        "files"
      ],
      "title": "ValidationResult",
      "type": "object"
    },
    "WhisperCppSettings": {
      "additionalProperties": false,
      "properties": {
        "dtw": {
          "title": "Dtw",
          "type": "string"
        },
        "entropy_threshold": {
          "title": "Entropy Threshold",
          "type": "number"
        },
        "logprob_threshold": {
          "title": "Logprob Threshold",
          "type": "number"
        },
        "max_word_duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Word Duration Seconds",
          "type": "number"
        },
        "no_context": {
          "title": "No Context",
          "type": "boolean"
        },
        "no_speech_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "No Speech Threshold",
          "type": "number"
        },
        "repetition_limit": {
          "minimum": 0,
          "title": "Repetition Limit",
          "type": "integer"
        },
        "temperature": {
          "maximum": 1,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "temperature_increment": {
          "maximum": 1,
          "minimum": 0,
          "title": "Temperature Increment",
          "type": "number"
        },
        "threads": {
          "minimum": 0,
          "title": "Threads",
          "type": "integer"
        },
        "vad": {
          "title": "Vad",
          "type": "boolean"
        },
        "vad_model": {
          "anyOf": [
            {
              "maxLength": 32768,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vad Model"
        },
        "vad_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Vad Threshold",
          "type": "number"
        }
      },
      "title": "WhisperCppSettings",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/PresetList"
    },
    {
      "$ref": "#/$defs/PolicyList"
    },
    {
      "$ref": "#/$defs/ValidationResult"
    }
  ],
  "title": "Utteran B5 private settings preview and collections"
}

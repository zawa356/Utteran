{
  "$defs": {
    "CancelRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "cooperative",
            "force"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "mode"
      ],
      "title": "CancelRequest",
      "type": "object"
    },
    "EditingSession": {
      "additionalProperties": false,
      "properties": {
        "common_overrides": {
          "items": {
            "$ref": "#/$defs/SettingOverride"
          },
          "title": "Common Overrides",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileInput"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "preset_ref": {
          "$ref": "#/$defs/Ref"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "preset_ref",
        "policy_ref",
        "common_overrides",
        "files"
      ],
      "title": "EditingSession",
      "type": "object"
    },
    "FileInput": {
      "additionalProperties": false,
      "properties": {
        "client_file_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Client File Id",
          "type": "string"
        },
        "input_path": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Input Path",
          "type": "string"
        },
        "output_dir": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Output Dir",
          "type": "string"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/SettingOverride"
          },
          "title": "Overrides",
          "type": "array"
        }
      },
      "required": [
        "client_file_id",
        "input_path",
        "output_dir",
        "overrides"
      ],
      "title": "FileInput",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Message Key",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code",
        "message_key"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/JobAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "block_reason": {
          "anyOf": [
            {
              "enum": [
                "input_changed",
                "input_unavailable",
                "output_unavailable",
                "candidate_changed",
                "candidate_unavailable",
                "resolver_unavailable",
                "worker_plan_unsupported"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Reason"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Blockers",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobErrorView"
            },
            {
              "type": "null"
            }
          ]
        },
        "held": {
          "title": "Held",
          "type": "boolean"
        },
        "id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "recovery_required": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "rerun_of": {
          "anyOf": [
            {
              "pattern": "^job_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rerun Of"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_of": {
          "anyOf": [
            {
              "pattern": "^job_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retry Of"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/JobSnapshotSummary"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "status",
        "held",
        "blockers",
        "block_reason",
        "recovery_required",
        "reason_code",
        "snapshot",
        "attempts",
        "retry_of",
        "rerun_of",
        "result",
        "error",
        "created_at",
        "updated_at"
      ],
      "title": "Job",
      "type": "object"
    },
    "JobAttempt": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "id": {
          "pattern": "^att_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "launch": {
          "enum": [
            "intended",
            "confirmed",
            "failed"
          ],
          "title": "Launch",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "released",
            "interrupted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "number",
        "state",
        "launch",
        "started_at",
        "ended_at"
      ],
      "title": "JobAttempt",
      "type": "object"
    },
    "JobBatch": {
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "items": {
            "$ref": "#/$defs/Job"
          },
          "minItems": 1,
          "title": "Jobs",
          "type": "array"
        },
        "queue_revision": {
          "minimum": 1,
          "title": "Queue Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "jobs",
        "queue_revision"
      ],
      "title": "JobBatch",
      "type": "object"
    },
    "JobErrorView": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "start_failed",
            "profile_invalid",
            "profile_unavailable",
            "profile_incompatible",
            "module_missing",
            "handshake_timeout",
            "protocol_mismatch",
            "schema_mismatch",
            "malformed_message",
            "oversized_message",
            "invalid_sequence",
            "id_mismatch",
            "worker_crash",
            "unexpected_eof",
            "io_timeout",
            "process_timeout",
            "validation_timeout",
            "cancelled",
            "core_failure",
            "invalid_context",
            "unsupported_setting",
            "model_missing",
            "dependency_missing",
            "artifact_invalid",
            "input_changed",
            "result_mismatch",
            "worker_plan_unsupported"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "JobErrorView",
      "type": "object"
    },
    "JobList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Job"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "items",
        "next_cursor"
      ],
      "title": "JobList",
      "type": "object"
    },
    "JobResult": {
      "additionalProperties": false,
      "description": "Verified completion evidence. Links to the legacy core job; no artifact paths.",
      "properties": {
        "artifact_count": {
          "maximum": 5,
          "minimum": 1,
          "title": "Artifact Count",
          "type": "integer"
        },
        "legacy_core_job_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Legacy Core Job Id",
          "type": "string"
        },
        "verified": {
          "const": true,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "legacy_core_job_id",
        "artifact_count",
        "verified"
      ],
      "title": "JobResult",
      "type": "object"
    },
    "JobSnapshotSummary": {
      "additionalProperties": false,
      "properties": {
        "client_file_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Client File Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_identity": {
          "pattern": "^in_[0-9a-f]{32}$",
          "title": "Input Identity",
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/Ref"
        },
        "preset_ref": {
          "$ref": "#/$defs/Ref"
        },
        "resume_mode": {
          "enum": [
            "resume",
            "fresh",
            "force"
          ],
          "title": "Resume Mode",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/ResolvedSpecView"
        }
      },
      "required": [
        "created_at",
        "client_file_id",
        "preset_ref",
        "policy_ref",
        "resume_mode",
        "input_identity",
        "spec"
      ],
      "title": "JobSnapshotSummary",
      "type": "object"
    },
    "JobSubmit": {
      "additionalProperties": false,
      "properties": {
        "editing_session": {
          "$ref": "#/$defs/EditingSession"
        },
        "resolution_token": {
          "maxLength": 128,
          "pattern": "^v1\\.[0-9a-f]{32}\\.[0-9]{13}\\.[0-9a-f]{64}$",
          "title": "Resolution Token",
          "type": "string"
        },
        "resume_mode": {
          "enum": [
            "resume",
            "fresh",
            "force"
          ],
          "title": "Resume Mode",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "resolution_token",
        "editing_session",
        "resume_mode"
      ],
      "title": "JobSubmit",
      "type": "object"
    },
    "JsonValue": {},
    "OperationStatus": {
      "enum": [
        "queued",
        "held",
        "blocked",
        "running",
        "waiting_user",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "OperationStatus",
      "type": "string"
    },
    "QueueControl": {
      "additionalProperties": false,
      "properties": {
        "dispatch": {
          "enum": [
            "running",
            "paused"
          ],
          "title": "Dispatch",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "dispatch"
      ],
      "title": "QueueControl",
      "type": "object"
    },
    "QueueItemPatch": {
      "additionalProperties": false,
      "properties": {
        "held": {
          "title": "Held",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "held"
      ],
      "title": "QueueItemPatch",
      "type": "object"
    },
    "QueueItemView": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Blockers",
          "type": "array"
        },
        "held": {
          "title": "Held",
          "type": "boolean"
        },
        "id": {
          "pattern": "^qi_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position"
        },
        "resource_id": {
          "pattern": "^(job|setup|refresh)_[0-9a-f]{32}$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "job",
            "setup_operation"
          ],
          "title": "Resource Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource_id",
        "resource_kind",
        "position",
        "held",
        "blockers"
      ],
      "title": "QueueItemView",
      "type": "object"
    },
    "QueueOrder": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "waiting_item_ids": {
          "items": {
            "pattern": "^qi_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Waiting Item Ids",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "waiting_item_ids"
      ],
      "title": "QueueOrder",
      "type": "object"
    },
    "QueueView": {
      "additionalProperties": false,
      "properties": {
        "active_item_id": {
          "anyOf": [
            {
              "pattern": "^qi_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Item Id"
        },
        "dispatch": {
          "enum": [
            "running",
            "paused"
          ],
          "title": "Dispatch",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/QueueItemView"
          },
          "title": "Items",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "dispatch",
        "active_item_id",
        "items"
      ],
      "title": "QueueView",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Fixed reason vocabulary. Free-form caller text is never stored or echoed.",
      "enum": [
        "submitted",
        "user_hold",
        "user_release",
        "user_reorder",
        "user_cancel",
        "cancel_accepted",
        "prestart_revalidation_failed",
        "resources_available",
        "dispatch_started",
        "launch_confirmed",
        "launch_failed",
        "completion_verified",
        "classified_failure",
        "termination_failed",
        "exit_reconciled",
        "credential_required",
        "agreement_required",
        "explicit_resume",
        "owner_lost",
        "recovery_held",
        "recovery_paused",
        "recovery_owner_unverified",
        "recovery_pid_reused",
        "recovery_launch_unconfirmed",
        "recovery_child_alive",
        "queue_paused",
        "queue_resumed",
        "step_progress",
        "reapproval_required"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RequestedRoute": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "enum": [
            "cpu",
            "cuda",
            "gpu",
            "npu",
            "vulkan",
            "selected-device",
            "backend-default"
          ],
          "title": "Decoder",
          "type": "string"
        },
        "encoder": {
          "enum": [
            "cpu",
            "cuda",
            "gpu",
            "npu",
            "openvino-gpu",
            "selected-device",
            "backend-default"
          ],
          "title": "Encoder",
          "type": "string"
        },
        "native_variant": {
          "anyOf": [
            {
              "enum": [
                "cpu",
                "vulkan",
                "openvino",
                "openvino_vulkan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Variant"
        }
      },
      "required": [
        "native_variant",
        "encoder",
        "decoder"
      ],
      "title": "RequestedRoute",
      "type": "object"
    },
    "RerunRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "submission": {
          "$ref": "#/$defs/JobSubmit"
        }
      },
      "required": [
        "schema_version",
        "submission"
      ],
      "title": "RerunRequest",
      "type": "object"
    },
    "Resolution": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ResolvedFileView"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "id": {
          "pattern": "^res_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "token": {
          "maxLength": 128,
          "pattern": "^v1\\.[0-9a-f]{32}\\.[0-9]{13}\\.[0-9a-f]{64}$",
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "token",
        "expires_at",
        "files"
      ],
      "title": "Resolution",
      "type": "object"
    },
    "ResolvedFileView": {
      "additionalProperties": false,
      "properties": {
        "client_file_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Client File Id",
          "type": "string"
        },
        "input_identity": {
          "pattern": "^in_[0-9a-f]{32}$",
          "title": "Input Identity",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/ResolvedSpecView"
        }
      },
      "required": [
        "client_file_id",
        "input_identity",
        "spec"
      ],
      "title": "ResolvedFileView",
      "type": "object"
    },
    "ResolvedSpecView": {
      "additionalProperties": false,
      "description": "Allowlisted projection of a ResolvedSpec: no settings, model path or prompt.",
      "properties": {
        "backend": {
          "enum": [
            "faster-whisper",
            "whisper-cpp",
            "openvino-genai"
          ],
          "title": "Backend",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "compute_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Compute Type",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda",
            "gpu",
            "npu"
          ],
          "title": "Device",
          "type": "string"
        },
        "evidence_kinds": {
          "items": {
            "enum": [
              "smoke",
              "benchmark",
              "static_rule"
            ],
            "type": "string"
          },
          "title": "Evidence Kinds",
          "type": "array"
        },
        "fallback_candidate_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "title": "Fallback Candidate Ids",
          "type": "array"
        },
        "inventory_revision": {
          "minimum": 1,
          "title": "Inventory Revision",
          "type": "integer"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {

        "formats": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "srt",
                  "vtt",
                  "json",
                  "txt",
                  "md"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formats"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "output_dir": {
          "maxLength": 32768,
          "title": "Output Dir",
          "type": "string"
        },
        "output_source": {
          "anyOf": [
            {
              "enum": [
                "saved_default",
                "picker",
                "typed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Source"
